---
// Shared HTML shell: fonts, global styles, meta. Terminal chrome for
// content pages lives in Site.astro; the flight deck home composes this
// directly.
import { SITE } from '../data/site';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  /** 'article' for blog posts; adds article:* meta. */
  ogType?: 'website' | 'article';
  /** Override the default per-page generated card, as a site-relative path. */
  ogImage?: string;
  publishedDate?: Date;
  tags?: string[];
}

const {
  title,
  description = SITE.description,
  ogType = 'website',
  ogImage,
  publishedDate,
  tags = [],
} = Astro.props;
const pageTitle = title ? `${title} · ${SITE.name}` : SITE.title;

// Social meta. og:title stays unsuffixed — LinkedIn truncates ~70 chars and
// shows the domain on its own line. Every page gets a build-time card from
// src/pages/og/ unless ogImage overrides it.
const ogTitle = title ?? SITE.title;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogSlug = Astro.url.pathname.replace(/\/$/, '').replace(/^\//, '') || 'index';
const ogImageURL = new URL(ogImage ?? `/og/${ogSlug}.png`, Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={ogTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImageURL} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="627" />
    <meta property="og:image:alt" content={`${ogTitle} — ${SITE.name}`} />
    {ogType === 'article' && publishedDate && (
      <meta property="article:published_time" content={publishedDate.toISOString()} />
    )}
    {ogType === 'article' && tags.map((tag) => <meta property="article:tag" content={tag} />)}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={ogTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageURL} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500;700&family=Space+Grotesk:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <slot />
  </body>
</html>
