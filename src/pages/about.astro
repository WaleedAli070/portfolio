---
// About — bio, career timeline, skills (design/Site.dc.html, #about).
import Site from "../layouts/Site.astro";
import JsonLd from "../components/JsonLd.astro";
import { SITE, PERSON_LD } from "../data/site";
import { BIO, EXPERIENCE, SKILLS } from "../data/career";
---

<Site title="About" path="~/about">
  <JsonLd data={PERSON_LD} />
  <div class="cmd">$ whoami<span class="cursor"></span></div>
  <h1>{SITE.name}</h1>
  <div class="roles">{SITE.roles}</div>
  {BIO.map((para) => <p class="bio">{para}</p>)}

  <div class="cmd section">$ cat career.log</div>
  <div class="timeline">
    {
      EXPERIENCE.map((job) => (
        <div class="job">
          <div class="job-dot" style={`--dot: ${job.dot}`} />
          <div>
            <div class="job-role">{job.role}</div>
            <div class="job-meta">
              {job.org} &nbsp;·&nbsp; {job.when}
            </div>
            <div class="job-detail">{job.detail}</div>
          </div>
        </div>
      ))
    }
  </div>

  <div class="cmd section-sm">$ ls skills/</div>
  <div class="chips">
    {SKILLS.map((s) => <span class="chip">{s}</span>)}
  </div>
</Site>

<style>
  .cmd {
    font-size: 13px;
    color: var(--green);
    margin-bottom: 18px;
  }
  .cmd.section {
    margin: 44px 0 20px;
  }
  .cmd.section-sm {
    margin: 32px 0 18px;
  }
  .cursor {
    display: inline-block;
    width: 7px;
    height: 14px;
    background: var(--green);
    margin-left: 4px;
    vertical-align: middle;
    animation: blink 1.05s step-end infinite;
  }
  h1 {
    font-family: var(--font-display);
    font-size: clamp(34px, 5vw, 54px);
    line-height: 1.02;
    margin: 0 0 12px;
    font-weight: 600;
    letter-spacing: -0.02em;
    color: var(--text-bright);
  }
  .roles {
    font-size: 14px;
    color: var(--cyan);
    margin-bottom: 22px;
  }
  .bio {
    font-size: 15px;
    line-height: 1.8;
    color: var(--text-body);
    max-width: 64ch;
    text-wrap: pretty;
    margin: 0 0 14px;
  }

  .timeline {
    display: flex;
    flex-direction: column;
  }
  .job {
    display: flex;
    gap: 18px;
    padding: 0 0 26px;
    position: relative;
    padding-left: 26px;
    border-left: 2px solid var(--border);
  }
  .job-dot {
    position: absolute;
    left: -6px;
    top: 4px;
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: var(--dot);
    box-shadow: 0 0 10px var(--dot);
  }
  .job-role {
    font-family: var(--font-display);
    font-size: 16px;
    font-weight: 600;
    color: var(--text-bright);
  }
  .job-meta {
    font-size: 12px;
    color: var(--amber);
    margin: 3px 0 8px;
  }
  .job-detail {
    font-size: 14px;
    line-height: 1.65;
    color: var(--text-soft);
    max-width: 60ch;
    text-wrap: pretty;
  }

  .chips {
    display: flex;
    flex-flow: row wrap;
    gap: 8px;
  }
  .chip {
    font-size: 12.5px;
    padding: 5px 11px;
    border-radius: 6px;
    background: rgba(6, 182, 212, 0.1);
    color: var(--cyan-soft);
    border: 1px solid rgba(6, 182, 212, 0.22);
  }
</style>
