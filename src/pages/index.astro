---
// Flight deck — interim static version. The full canvas game
// (design/Home.dc.html: ship, asteroids, lander) replaces the center of
// this screen in a later phase; the chrome and nav nodes here already
// match the design.
import Base from '../layouts/Base.astro';
import { SITE } from '../data/site';

const NODES = [
  { label: 'about.me', sigil: '@', color: 'var(--green)', href: '/about' },
  { label: 'projects', sigil: '#', color: 'var(--cyan)', href: '/projects' },
  { label: 'writing', sigil: '*', color: 'var(--amber)', href: '/blog' },
  { label: 'contact', sigil: '>', color: 'var(--violet)', href: '/contact' },
  { label: 'resume.pdf', sigil: '^', color: 'var(--pink)', href: '/resume.pdf' },
];
---

<Base>
  <div class="deck">
    <header class="titlebar">
      <span class="light red"></span>
      <span class="light amber"></span>
      <span class="light green"></span>
      <span class="prompt">pilot@flight-deck: ~/home</span>
      <span class="spacer"></span>
      <a class="btn" href="/resume.pdf" download>wget resume.pdf</a>
    </header>

    <main class="space">
      <div class="intro">
        <div class="cmd">$ whoami<span class="cursor"></span></div>
        <h1>{SITE.name}</h1>
        <div class="roles">{SITE.roles}</div>
        <p class="blurb">
          ~10 years across the stack — IoT, AV simulation, zero-trust networking, fintech
          infrastructure. I build platforms that stay calm under pressure, and lead the teams
          that run them.
        </p>
        <div class="hint">flight systems calibrating — the mini-game docks here soon</div>
      </div>

      <nav class="nodes" aria-label="Sections">
        <div class="nodes-label">nav nodes</div>
        <div class="nodes-row">
          {
            NODES.map((n) => (
              <a class="node" href={n.href} style={`--node: ${n.color}`}>
                <span class="node-dot" />
                <span class="node-name">{n.label}</span>
                <span class="node-sigil">{n.sigil}</span>
              </a>
            ))
          }
        </div>
      </nav>
    </main>

    <footer class="statusbar">
      <span class="online"><span class="dot"></span>online</span>
      <span>{SITE.version} — flight deck</span>
    </footer>
  </div>
</Base>

<style>
  .deck {
    position: relative;
    display: flex;
    flex-direction: column;
    height: 100vh;
    height: 100dvh;
    overflow: hidden;
    background:
      radial-gradient(120% 120% at 50% 40%, rgba(0, 0, 0, 0) 45%, rgba(0, 0, 0, 0.55) 100%),
      var(--bg);
  }

  .titlebar {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 11px 16px;
    background: rgba(9, 14, 22, 0.78);
    border-bottom: 1px solid var(--border-soft);
    backdrop-filter: blur(8px);
    flex-shrink: 0;
  }
  .light {
    width: 11px;
    height: 11px;
    border-radius: 50%;
    display: inline-block;
    flex-shrink: 0;
  }
  .light.red {
    background: var(--red);
  }
  .light.amber {
    background: var(--amber);
  }
  .light.green {
    background: var(--green);
  }
  .prompt {
    margin-left: 8px;
    font-size: 12.5px;
    color: var(--text-label);
    letter-spacing: 0.4px;
  }
  .spacer {
    flex: 1;
  }
  .btn {
    font-size: 12px;
    color: var(--green);
    border: 1px solid rgba(52, 211, 153, 0.4);
    background: rgba(52, 211, 153, 0.08);
    padding: 6px 12px;
    border-radius: 6px;
    transition: background 0.18s;
    white-space: nowrap;
  }
  .btn:hover {
    background: rgba(52, 211, 153, 0.18);
    color: var(--green);
  }

  .space {
    position: relative;
    flex: 1;
    min-height: 0;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    padding: 22px;
  }
  .intro {
    max-width: min(480px, 90vw);
  }
  .cmd {
    font-size: 12.5px;
    color: var(--green);
    margin-bottom: 14px;
    font-weight: 500;
  }
  .cursor {
    display: inline-block;
    width: 7px;
    height: 14px;
    background: var(--green);
    margin-left: 4px;
    vertical-align: middle;
    animation: blink 1.05s step-end infinite;
  }
  h1 {
    font-family: var(--font-display);
    font-size: clamp(30px, 4.4vw, 52px);
    line-height: 1.02;
    margin: 0 0 10px;
    font-weight: 600;
    letter-spacing: -0.02em;
    color: var(--text-bright);
    text-wrap: balance;
  }
  .roles {
    font-size: 13.5px;
    color: var(--cyan);
    margin-bottom: 14px;
    letter-spacing: 0.2px;
  }
  .blurb {
    font-size: 13px;
    line-height: 1.7;
    color: var(--text-soft);
    margin: 0;
    max-width: 44ch;
    text-wrap: pretty;
  }
  .hint {
    margin-top: 18px;
    font-size: 11.5px;
    color: var(--text-faint);
  }

  .nodes-label {
    font-size: 10.5px;
    color: var(--text-ghost);
    letter-spacing: 1.5px;
    text-transform: uppercase;
    margin-bottom: 9px;
  }
  .nodes-row {
    display: flex;
    flex-flow: row wrap;
    gap: 6px;
  }
  .node {
    display: flex;
    align-items: center;
    gap: 9px;
    font-size: 12.5px;
    padding: 5px 10px;
    border-radius: 6px;
    background: rgba(9, 14, 22, 0.6);
    border: 1px solid #172433;
    color: var(--text-muted);
    transition:
      border-color 0.18s,
      background 0.18s;
  }
  .node:hover {
    border-color: #2c4058;
    background: rgba(15, 23, 36, 0.85);
    color: var(--text);
  }
  .node-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--node);
    box-shadow: 0 0 8px var(--node);
    flex-shrink: 0;
  }
  .node-name {
    min-width: 74px;
  }
  .node-sigil {
    color: var(--node);
    font-size: 11px;
  }

  .statusbar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 8px 16px;
    background: rgba(9, 14, 22, 0.78);
    border-top: 1px solid var(--border-soft);
    backdrop-filter: blur(8px);
    font-size: 11px;
    color: var(--text-faint);
    flex-shrink: 0;
  }
  .online {
    display: flex;
    align-items: center;
    gap: 7px;
  }
  .dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--green);
    animation: pulseDot 2s ease-in-out infinite;
  }
</style>
