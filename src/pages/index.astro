---
// Flight deck — the / canvas game from design/Home.dc.html. The static
// .fallback layer is what no-JS and prefers-reduced-motion visitors get;
// everyone else gets the playable deck (ship, asteroids, nav nodes) and
// the lunar-lander mini-game. Game logic lives in src/scripts/flightdeck/.
import { getCollection } from "astro:content";
import Base from "../layouts/Base.astro";
import { SITE } from "../data/site";
import { EXPERIENCE } from "../data/career";
import { COMPANY_PROJECTS, PERSONAL_PROJECTS } from "../data/projects";

const NODES = [
  {
    key: "about",
    label: "about.me",
    sigil: "@",
    color: "#34d399",
    fx: 0.15,
    fy: 0.56,
    href: "/about",
  },
  {
    key: "projects",
    label: "projects",
    sigil: "#",
    color: "#22d3ee",
    fx: 0.8,
    fy: 0.26,
    href: "/projects",
  },
  {
    key: "blogs",
    label: "writing",
    sigil: "*",
    color: "#fbbf24",
    fx: 0.24,
    fy: 0.78,
    href: "/blog",
  },
  {
    key: "contact",
    label: "contact",
    sigil: ">",
    color: "#a78bfa",
    fx: 0.8,
    fy: 0.76,
    href: "/contact",
  },
  {
    key: "resume",
    label: "resume.pdf",
    sigil: "^",
    color: "#f472b6",
    fx: 0.5,
    fy: 0.14,
    href: "/resume.pdf",
  },
];

// Tunables from the design's data-props.
const CONFIG = { lethalAsteroids: true, asteroidCount: 5, thrustPower: 0.34 };

const posts = (await getCollection("blog", ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);
const topProjects = COMPANY_PROJECTS.slice(0, 3);
const projectCount = COMPANY_PROJECTS.length + PERSONAL_PROJECTS.length;

interface DeckCard {
  key: string;
  subtitle: string;
  title: string;
  lines: string[];
  cta: { label: string; href: string; download?: boolean };
}

const CARDS: DeckCard[] = [
  {
    key: "about",
    subtitle: "cat about.txt",
    title: "About",
    lines: [
      "Engineering Manager & Staff Engineer — ~10 yrs across the stack.",
      "Path: IoT dashboards → AV simulation → zero-trust → fintech.",
      `Now leading engineering at ${EXPERIENCE[0].org} — wellness platform + fintech treasury.`,
      "I care about calm, observable, predictable systems.",
    ],
    cta: { label: "read full bio →", href: "/about" },
  },
  {
    key: "projects",
    subtitle: "ls -la projects/",
    title: "Projects",
    lines: [
      ...topProjects.map((p) => `${p.name} — ${p.tags.join(" · ")}`),
      `showing ${topProjects.length} of ${projectCount} — the rest are on the projects page.`,
    ],
    cta: { label: "open all projects →", href: "/projects" },
  },
  {
    key: "blogs",
    subtitle: "cat blogs/*.md",
    title: "Writing",
    lines: posts.map((p) => p.data.title),
    cta: { label: "read the blog →", href: "/blog" },
  },
  {
    key: "contact",
    subtitle: "./contact --send",
    title: "Contact",
    lines: [
      "Open to staff / architecture / EM conversations.",
      `Fastest route is email — ${SITE.email}.`,
      `Also on GitHub (${SITE.githubLabel}) and LinkedIn.`,
    ],
    cta: { label: "get in touch →", href: "/contact" },
  },
  {
    key: "resume",
    subtitle: "wget resume.pdf",
    title: "Résumé",
    lines: [
      "Engineering Manager / Staff Engineer track.",
      "PDF · last updated Feb 2026.",
    ],
    cta: { label: "download resume.pdf", href: "/resume.pdf", download: true },
  },
];

const cardColor = (key: string) => NODES.find((n) => n.key === key)!.color;
const hexAlpha = (hex: string, a: number) => {
  const n = parseInt(hex.slice(1), 16);
  return `rgba(${(n >> 16) & 255},${(n >> 8) & 255},${n & 255},${a})`;
};
const cardStyle = (key: string) => {
  const c = cardColor(key);
  return `--accent:${c};--accent-border:${hexAlpha(c, 0.45)};--glow:${hexAlpha(c, 0.18)};--cta-bg:${hexAlpha(c, 0.1)}`;
};

const BOOT_LINES = [
  { text: `portfolio.sys ${SITE.version} — initializing`, color: "#8b9bb0" },
  { text: "> mounting /dev/starfield ......... ok", color: "#647689" },
  { text: "> loading pilot profile ........... ok", color: "#647689" },
  { text: "> calibrating thrusters ........... ok", color: "#647689" },
  { text: "> arming cannon ................... ok", color: "#647689" },
];

const fdData = {
  config: CONFIG,
  nodes: NODES.map(({ key, label, sigil, color, fx, fy }) => ({
    key,
    label,
    sigil,
    color,
    fx,
    fy,
  })),
};
---

<Base>
  <div class="deck" id="deck">
    <canvas class="game-canvas" id="fd-canvas"></canvas>
    <div class="scanlines"></div>
    <div class="vignette"></div>

    <div class="chrome">
      <header class="titlebar">
        <span class="light red"></span>
        <span class="light amber"></span>
        <span class="light green"></span>
        <span class="prompt">pilot@flight-deck: ~/home</span>
        <span class="spacer"></span>
        <button class="btn btn-violet" id="mode-btn" hidden>▶ lander</button>
        <a class="btn" href="/resume.pdf" download>wget resume.pdf</a>
      </header>

      <main class="space">
        <!-- static fallback: no JS, or prefers-reduced-motion -->
        <div class="fallback">
          <div class="intro">
            <div class="cmd">$ whoami<span class="cursor"></span></div>
            <h1>{SITE.name}</h1>
            <div class="roles">{SITE.roles}</div>
            <p class="blurb">
              ~10 years across the stack — IoT, AV simulation, zero-trust
              networking, fintech infrastructure. I build platforms that stay
              calm under pressure, and lead the teams that run them.
            </p>
          </div>

          <nav class="nodes" aria-label="Sections">
            <div class="nodes-label">nav nodes</div>
            <div class="nodes-row">
              {
                NODES.map((n) => (
                  <a class="node" href={n.href} style={`--node: ${n.color}`}>
                    <span class="node-dot" />
                    <span class="node-name">{n.label}</span>
                    <span class="node-sigil">{n.sigil}</span>
                  </a>
                ))
              }
            </div>
          </nav>
        </div>

        <!-- interactive game layer -->
        <div class="game" id="game" data-mode="deck">
          <div class="deck-hud">
            <div class="intro">
              <div class="cmd">$ whoami<span class="cursor"></span></div>
              <h1>{SITE.name}</h1>
              <div class="roles">{SITE.roles}</div>
              <p class="blurb">
                ~10 years across the stack — IoT, AV simulation, zero-trust
                networking, fintech infrastructure. I build platforms that stay
                calm under pressure.
              </p>
              <div class="keys-hint">
                <span class="k-label">fly:</span>
                <span class="k-val">WASD / ↑ ↓ ← →</span>
                &nbsp;·&nbsp;
                <span class="k-label">fire:</span>
                <span class="k-val">SPACE</span><br />
                <span>explore the nodes to open each section</span>
              </div>
            </div>
          </div>

          <div class="score-panel">
            <div class="score-row deck-row">
              <span>score</span><span class="score-val" id="score">0</span>
            </div>
            <div class="score-row deck-row">
              <span>found</span><span class="found-val" id="found"
                >0/{NODES.length}</span
              >
            </div>
            <div class="score-row lander-row">
              <span>landed</span><span class="found-val" id="landed-count"
                >0</span
              >
            </div>
            <div class="score-row lander-row">
              <span>crashed</span><span class="crashed-val" id="crashed-count"
                >0</span
              >
            </div>
          </div>

          <nav class="nodes" aria-label="Sections">
            <div class="nodes-label">nav nodes</div>
            <div class="nodes-row">
              {
                NODES.map((n) => (
                  <button
                    class="node"
                    data-node={n.key}
                    style={`--node: ${n.color}`}
                  >
                    <span class="node-dot" />
                    <span class="node-name">{n.label}</span>
                    <span class="node-check">·</span>
                  </button>
                ))
              }
            </div>
          </nav>

          <div class="touch" id="touch" hidden>
            <div class="dpad">
              <span></span>
              <button data-dir="up">↑</button>
              <span></span>
              <button data-dir="left">←</button>
              <button data-dir="down">↓</button>
              <button data-dir="right">→</button>
            </div>
            <button class="fire" data-dir="fire">FIRE</button>
          </div>

          <div class="card-overlay" id="card-overlay" hidden>
            {
              CARDS.map((c) => (
                <article
                  class="card"
                  data-card={c.key}
                  hidden
                  style={cardStyle(c.key)}
                >
                  <div class="card-head">
                    <div class="card-sub">$ {c.subtitle}</div>
                    <button class="card-close" aria-label="Close">
                      ✕
                    </button>
                  </div>
                  <h2>{c.title}</h2>
                  <div class="card-lines">
                    {c.lines.map((line) => (
                      <div class="card-line">
                        <span class="card-arrow">›</span>
                        <span>{line}</span>
                      </div>
                    ))}
                  </div>
                  <a
                    class="card-cta"
                    href={c.cta.href}
                    download={c.cta.download}
                  >
                    {c.cta.label}
                  </a>
                </article>
              ))
            }
          </div>

          <div class="lander-hud">
            <div class="telemetry-wrap">
              <div class="telemetry">
                <div class="tele">
                  <div class="tele-label">ALT</div>
                  <div class="tele-val" id="lander-alt">000</div>
                </div>
                <div class="tele">
                  <div class="tele-label">V-SPD</div>
                  <div class="tele-val" id="lander-vs">0.0</div>
                </div>
                <div class="tele">
                  <div class="tele-label">H-SPD</div>
                  <div class="tele-val" id="lander-hs">0.0</div>
                </div>
                <div class="tele">
                  <div class="tele-label">FUEL</div>
                  <div class="fuel-bar">
                    <div class="fuel-fill" id="lander-fuel"></div>
                  </div>
                </div>
              </div>
              <div class="lander-hint">
                ↑ / W thrust &nbsp;·&nbsp; ← → rotate &nbsp;·&nbsp; set her down
                soft on the pad
              </div>
            </div>
            <div class="lander-result" id="lander-result" hidden>
              <div class="result-box" id="result-box">
                <div class="result-title" id="result-title"></div>
                <div class="result-msg" id="result-msg"></div>
                <div class="result-actions">
                  <button class="retry-btn" id="retry-lander">retry</button>
                  <button class="exit-btn" id="exit-lander-2"
                    >flight deck</button
                  >
                </div>
              </div>
            </div>
          </div>
        </div>
      </main>

      <footer class="statusbar">
        <span class="online"><span class="dot"></span>online</span>
        <span class="coords" id="coords" hidden>x:000 y:000</span>
        <span>{SITE.version} — flight deck</span>
      </footer>
    </div>

    <div class="boot" id="boot" hidden>
      <div class="boot-inner">
        {
          BOOT_LINES.map((l) => (
            <div class="boot-line" style={`color: ${l.color}`}>
              {l.text}
            </div>
          ))
        }
        <div class="boot-launch">
          launching flight deck<span class="cursor"></span>
        </div>
        <button class="boot-skip" id="boot-skip">skip →</button>
      </div>
    </div>
    <script
      is:inline
      type="application/json"
      id="fd-data"
      set:html={JSON.stringify(fdData)}
    />
  </div>
</Base>

<script>
  import { createFlightDeck } from "../scripts/flightdeck";

  const deckEl = document.getElementById("deck");
  const canvas = document.getElementById(
    "fd-canvas",
  ) as HTMLCanvasElement | null;
  const dataEl = document.getElementById("fd-data");
  const reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

  if (deckEl && canvas && dataEl && !reduced) {
    const { config, nodes } = JSON.parse(dataEl.textContent || "{}");
    deckEl.classList.add("play");

    const $ = (id: string) => document.getElementById(id)!;
    const gameEl = $("game");
    const scoreEl = $("score");
    const foundEl = $("found");
    const modeBtn = $("mode-btn");
    const coordsEl = $("coords");
    const cardOverlay = $("card-overlay");
    const cards = Array.from(
      cardOverlay.querySelectorAll<HTMLElement>("[data-card]"),
    );
    const legendItems = Array.from(
      gameEl.querySelectorAll<HTMLElement>("[data-node]"),
    );
    const resultEl = $("lander-result");
    const resultBox = $("result-box");
    let landedCount = 0;
    let crashedCount = 0;

    modeBtn.hidden = false;
    coordsEl.hidden = false;

    const showCard = (key: string) => {
      for (const c of cards) c.hidden = c.dataset.card !== key;
      cardOverlay.hidden = false;
    };
    const hideCard = () => {
      cardOverlay.hidden = true;
    };

    const fd = createFlightDeck({
      canvas,
      config,
      nodes,
      hud: {
        coords: coordsEl,
        alt: $("lander-alt"),
        vs: $("lander-vs"),
        hs: $("lander-hs"),
        fuel: $("lander-fuel"),
      },
      onScore: (s) => {
        scoreEl.textContent = String(s);
      },
      onNodeOpen: (key, discovered) => {
        foundEl.textContent = `${discovered}/${nodes.length}`;
        const item = legendItems.find((el) => el.dataset.node === key);
        item?.classList.add("found");
        const check = item?.querySelector(".node-check");
        if (check) check.textContent = "✓";
        showCard(key);
      },
      // fires at touchdown; the success modal waits for onLanderCelebrate
      onLanderResult: (kind) => {
        const landed = kind === "landed";
        if (landed) landedCount++;
        else crashedCount++;
        $("landed-count").textContent = String(landedCount);
        $("crashed-count").textContent = String(crashedCount);
        $("result-title").textContent = landed ? "touchdown ✓" : "crashed ✗";
        $("result-msg").textContent = landed
          ? "clean landing — flag planted, thrusters nominal."
          : "too hot, off-pad, or bad angle. try again.";
        resultBox.style.setProperty(
          "--result-color",
          landed ? "#34d399" : "#f87171",
        );
        resultBox.style.setProperty(
          "--result-border",
          landed ? "rgba(52,211,153,0.45)" : "rgba(248,113,113,0.45)",
        );
        if (!landed) resultEl.hidden = false;
      },
      onLanderCelebrate: () => {
        resultEl.hidden = false;
      },
    });

    for (const item of legendItems) {
      item.addEventListener("click", () => fd.openNode(item.dataset.node!));
    }
    for (const c of cards) {
      c.querySelector(".card-close")?.addEventListener("click", hideCard);
    }
    window.addEventListener("keydown", (e) => {
      if (e.key === "Escape" && !cardOverlay.hidden) hideCard();
    });

    const setMode = (m: "deck" | "lander") => {
      gameEl.dataset.mode = m;
      modeBtn.textContent = m === "lander" ? "▶ flight deck" : "▶ lander";
      resultEl.hidden = true;
      if (m === "lander") hideCard();
    };
    modeBtn.addEventListener("click", () => {
      if (gameEl.dataset.mode === "lander") {
        fd.exitLander();
        setMode("deck");
      } else {
        fd.startLander();
        setMode("lander");
      }
    });
    const exitLander = () => {
      fd.exitLander();
      setMode("deck");
    };
    $("exit-lander-2").addEventListener("click", exitLander);
    $("retry-lander").addEventListener("click", () => {
      fd.retryLander();
      resultEl.hidden = true;
    });

    const touchEl = $("touch");
    if (window.matchMedia("(pointer: coarse)").matches) {
      touchEl.hidden = false;
      for (const btn of Array.from(
        touchEl.querySelectorAll<HTMLElement>("[data-dir]"),
      )) {
        const dir = btn.dataset.dir as
          "up" | "down" | "left" | "right" | "fire";
        btn.addEventListener("pointerdown", (e) => {
          e.preventDefault();
          fd.setKey(dir, true);
        });
        for (const ev of [
          "pointerup",
          "pointercancel",
          "pointerleave",
        ] as const) {
          btn.addEventListener(ev, () => fd.setKey(dir, false));
        }
      }
    }

    // boot sequence — once per tab session
    const bootEl = $("boot");
    let bootSeen = false;
    try {
      bootSeen = sessionStorage.getItem("fd-boot") === "1";
    } catch {
      /* storage unavailable — boot every time */
    }
    if (!bootSeen) {
      bootEl.hidden = false;
      const lines = Array.from(
        bootEl.querySelectorAll<HTMLElement>(".boot-line"),
      );
      let i = 0;
      let t = 0;
      const done = () => {
        bootEl.hidden = true;
        try {
          sessionStorage.setItem("fd-boot", "1");
        } catch {
          /* ignore */
        }
      };
      const step = () => {
        if (i >= lines.length) {
          t = window.setTimeout(done, 420);
          return;
        }
        lines[i++].classList.add("show");
        t = window.setTimeout(step, 230);
      };
      t = window.setTimeout(step, 260);
      $("boot-skip").addEventListener("click", () => {
        clearTimeout(t);
        done();
      });
    }
  }
</script>

<style>
  [hidden] {
    display: none !important;
  }

  .deck {
    position: relative;
    height: 100vh;
    height: 100dvh;
    overflow: hidden;
    background: var(--bg);
  }

  .game-canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: 0;
    display: block;
  }
  .deck:not(.play) .game-canvas,
  .deck:not(.play) .game {
    display: none;
  }
  .deck.play .fallback {
    display: none;
  }

  .scanlines {
    position: absolute;
    inset: 0;
    z-index: 1;
    pointer-events: none;
    background: repeating-linear-gradient(
      180deg,
      rgba(0, 0, 0, 0) 0px,
      rgba(0, 0, 0, 0) 2px,
      rgba(0, 0, 0, 0.16) 3px
    );
    opacity: 0.6;
  }
  .vignette {
    position: absolute;
    inset: 0;
    z-index: 1;
    pointer-events: none;
    background: radial-gradient(
      120% 120% at 50% 40%,
      rgba(0, 0, 0, 0) 45%,
      rgba(0, 0, 0, 0.55) 100%
    );
  }

  .chrome {
    position: relative;
    z-index: 2;
    display: flex;
    flex-direction: column;
    height: 100%;
    pointer-events: none;
  }

  /* ---- titlebar / statusbar ---- */

  .titlebar {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 11px 16px;
    background: rgba(9, 14, 22, 0.78);
    border-bottom: 1px solid var(--border-soft);
    backdrop-filter: blur(8px);
    flex-shrink: 0;
    pointer-events: auto;
  }
  .light {
    width: 11px;
    height: 11px;
    border-radius: 50%;
    display: inline-block;
    flex-shrink: 0;
  }
  .light.red {
    background: var(--red);
  }
  .light.amber {
    background: var(--amber);
  }
  .light.green {
    background: var(--green);
  }
  .prompt {
    margin-left: 8px;
    font-size: 12.5px;
    color: var(--text-label);
    letter-spacing: 0.4px;
  }
  .spacer {
    flex: 1;
  }
  .btn {
    font-size: 12px;
    color: var(--green);
    border: 1px solid rgba(52, 211, 153, 0.4);
    background: rgba(52, 211, 153, 0.08);
    padding: 6px 12px;
    border-radius: 6px;
    transition: background 0.18s;
    white-space: nowrap;
    cursor: pointer;
  }
  .btn:hover {
    background: rgba(52, 211, 153, 0.18);
    color: var(--green);
  }
  .btn-violet {
    color: var(--violet);
    border-color: rgba(167, 139, 250, 0.4);
    background: rgba(167, 139, 250, 0.08);
  }
  .btn-violet:hover {
    background: rgba(167, 139, 250, 0.18);
    color: var(--violet);
  }

  .statusbar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 8px 16px;
    background: rgba(9, 14, 22, 0.78);
    border-top: 1px solid var(--border-soft);
    backdrop-filter: blur(8px);
    font-size: 11px;
    color: var(--text-faint);
    flex-shrink: 0;
    pointer-events: auto;
  }
  .online {
    display: flex;
    align-items: center;
    gap: 7px;
  }
  .dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--green);
    animation: pulseDot 2s ease-in-out infinite;
  }
  .coords {
    color: var(--text-ghost);
    letter-spacing: 0.5px;
  }

  .space {
    position: relative;
    flex: 1;
    min-height: 0;
  }

  /* ---- shared intro typography ---- */

  .cmd {
    font-size: 12.5px;
    color: var(--green);
    margin-bottom: 14px;
    font-weight: 500;
  }
  .cursor {
    display: inline-block;
    width: 7px;
    height: 14px;
    background: var(--green);
    margin-left: 4px;
    vertical-align: middle;
    animation: blink 1.05s step-end infinite;
  }
  h1 {
    font-family: var(--font-display);
    font-size: clamp(30px, 4.4vw, 52px);
    line-height: 1.02;
    margin: 0 0 10px;
    font-weight: 600;
    letter-spacing: -0.02em;
    color: var(--text-bright);
    text-wrap: balance;
  }
  .roles {
    font-size: 13.5px;
    color: var(--cyan);
    margin-bottom: 14px;
    letter-spacing: 0.2px;
  }
  .blurb {
    font-size: 13px;
    line-height: 1.7;
    color: var(--text-soft);
    margin: 0;
    max-width: 38ch;
    text-wrap: pretty;
  }
  .keys-hint {
    margin-top: 18px;
    font-size: 11.5px;
    color: var(--text-faint);
    line-height: 1.9;
  }
  .k-label {
    color: var(--text-muted);
  }
  .k-val {
    color: #c6d3e3;
  }

  /* ---- nav nodes legend (shared fallback + game) ---- */

  .nodes-label {
    font-size: 10.5px;
    color: var(--text-ghost);
    letter-spacing: 1.5px;
    text-transform: uppercase;
    margin-bottom: 9px;
  }
  .nodes-row {
    display: flex;
    flex-flow: row wrap;
    gap: 6px;
  }
  .node {
    display: flex;
    align-items: center;
    gap: 9px;
